# Out-of-tree build for the AES67 FPGA Ethernet + PHC driver.
# Module name differs from every component object (Kbuild requirement).
# Client of the spibone bus driver (../spibone): its header, and its symbols via
# KBUILD_EXTRA_SYMBOLS (Makefile).
obj-m += aes67_eth_drv.o
aes67_eth_drv-objs := aes67_eth.o aes67_bus.o aes67_phc.o
ccflags-y += -I$(src)/../spibone
