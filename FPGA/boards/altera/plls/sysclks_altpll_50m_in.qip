set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "sysclks_altpll_50m_in.cmp"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "sysclks_altpll_50m_in.ppf"]
