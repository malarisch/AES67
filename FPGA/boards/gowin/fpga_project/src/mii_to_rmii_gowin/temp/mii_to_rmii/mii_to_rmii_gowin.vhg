`protect end_protected
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
library gw2a;
use gw2a.components.all;

entity mii_to_rmii_gowin is
port(
  refclk :  in std_logic;
  rstn :  in std_logic;
  speedis_100 :  in std_logic;
  rmii_rx_crs_dv :  in std_logic;
  rmii_rx_er :  in std_logic;
  rmii_rxd :  in std_logic_vector(1 downto 0);
  rmii_tx_en :  out std_logic;
  rmii_txd :  out std_logic_vector(1 downto 0);
  mii_rx_clk :  out std_logic;
  mii_rx_dv :  out std_logic;
  mii_rx_er :  out std_logic;
  mii_rxd :  out std_logic_vector(3 downto 0);
  mii_tx_clk :  out std_logic;
  mii_tx_en :  in std_logic;
  mii_tx_er :  in std_logic;
  mii_txd :  in std_logic_vector(3 downto 0);
  mii_col :  out std_logic;
  mii_crs :  out std_logic);
end mii_to_rmii_gowin;
architecture beh of mii_to_rmii_gowin is
  signal VCC_0 : std_logic ;
  signal GND_0 : std_logic ;
  signal NN : std_logic;
  signal NN_0 : std_logic;
component \~rmii_txrx.mii_to_rmii_gowin\
port(
  mii_tx_en: in std_logic;
  speedis_100: in std_logic;
  refclk: in std_logic;
  VCC_0: in std_logic;
  rstn: in std_logic;
  rmii_rx_er: in std_logic;
  rmii_rx_crs_dv: in std_logic;
  mii_txd : in std_logic_vector(3 downto 0);
  rmii_rxd : in std_logic_vector(1 downto 0);
  mii_col: out std_logic;
  mii_crs: out std_logic;
  mii_tx_clk: out std_logic;
  rmii_tx_en: out std_logic;
  mii_rx_er: out std_logic;
  mii_rx_dv: out std_logic;
  rmii_txd : out std_logic_vector(1 downto 0);
  mii_rxd : out std_logic_vector(3 downto 0));
end component;
begin
VCC_s: VCC
port map (
  V => VCC_0);
GND_s: GND
port map (
  G => GND_0);
GSR_0: GSR
port map (
  GSRI => VCC_0);
u_rmii_txrx: \~rmii_txrx.mii_to_rmii_gowin\
port map(
  mii_tx_en => mii_tx_en,
  speedis_100 => speedis_100,
  refclk => refclk,
  VCC_0 => VCC_0,
  rstn => rstn,
  rmii_rx_er => rmii_rx_er,
  rmii_rx_crs_dv => rmii_rx_crs_dv,
  mii_txd(3 downto 0) => mii_txd(3 downto 0),
  rmii_rxd(1 downto 0) => rmii_rxd(1 downto 0),
  mii_col => mii_col,
  mii_crs => mii_crs,
  mii_tx_clk => NN,
  rmii_tx_en => rmii_tx_en,
  mii_rx_er => mii_rx_er,
  mii_rx_dv => NN_0,
  rmii_txd(1 downto 0) => rmii_txd(1 downto 0),
  mii_rxd(3 downto 0) => mii_rxd(3 downto 0));
  mii_rx_clk <= NN;
  mii_rx_dv <= NN_0;
  mii_tx_clk <= NN;
end beh;
