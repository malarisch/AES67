`pragma protect end_protected
module mii_to_rmii_gowin (
  refclk,
  rstn,
  speedis_100,
  rmii_rx_crs_dv,
  rmii_rx_er,
  rmii_rxd,
  rmii_tx_en,
  rmii_txd,
  mii_rx_clk,
  mii_rx_dv,
  mii_rx_er,
  mii_rxd,
  mii_tx_clk,
  mii_tx_en,
  mii_tx_er,
  mii_txd,
  mii_col,
  mii_crs
)
;
input refclk;
input rstn;
input speedis_100;
input rmii_rx_crs_dv;
input rmii_rx_er;
input [1:0] rmii_rxd;
output rmii_tx_en;
output [1:0] rmii_txd;
output mii_rx_clk;
output mii_rx_dv;
output mii_rx_er;
output [3:0] mii_rxd;
output mii_tx_clk;
input mii_tx_en;
input mii_tx_er;
input [3:0] mii_txd;
output mii_col;
output mii_crs;
wire VCC;
wire GND;
  \~rmii_txrx.mii_to_rmii_gowin  u_rmii_txrx (
    .mii_tx_en(mii_tx_en),
    .speedis_100(speedis_100),
    .refclk(refclk),
    .rstn(rstn),
    .rmii_rx_er(rmii_rx_er),
    .rmii_rx_crs_dv(rmii_rx_crs_dv),
    .mii_txd(mii_txd[3:0]),
    .rmii_rxd(rmii_rxd[1:0]),
    .mii_col(mii_col),
    .mii_crs(mii_crs),
    .mii_rx_clk(mii_rx_clk),
    .rmii_tx_en(rmii_tx_en),
    .mii_rx_er(mii_rx_er),
    .mii_rx_dv(mii_rx_dv),
    .rmii_txd(rmii_txd[1:0]),
    .mii_rxd(mii_rxd[3:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
assign mii_tx_clk = mii_rx_clk;
endmodule /* mii_to_rmii_gowin */
