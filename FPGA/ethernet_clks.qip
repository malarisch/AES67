set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "ethernet_clks_inst.v"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "ethernet_clks_bb.v"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "ethernet_clks.ppf"]
