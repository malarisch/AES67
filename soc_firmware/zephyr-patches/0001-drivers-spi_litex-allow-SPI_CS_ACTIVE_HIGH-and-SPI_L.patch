From f537b3665714771be1dd69f7334d1a59a2429f68 Mon Sep 17 00:00:00 2001
From: Mala <mala@macker.lol>
Date: Fri, 3 Jul 2026 15:30:53 +0200
Subject: [PATCH 1/5] drivers: spi_litex: allow SPI_CS_ACTIVE_HIGH and
 SPI_LOCK_ON

Local AES67 modification: SPI_CS_ACTIVE_HIGH deasserts CS during the
transfer (SD card init sequence needs clocks with CS high), SPI_LOCK_ON
is ignored (single master). Downgrade missing-clk_divider warning.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 drivers/spi/spi_litex.c | 30 +++++++++++++++++-------------
 1 file changed, 17 insertions(+), 13 deletions(-)

diff --git a/drivers/spi/spi_litex.c b/drivers/spi/spi_litex.c
index 3bc318fd4b..80fc735937 100644
--- a/drivers/spi/spi_litex.c
+++ b/drivers/spi/spi_litex.c
@@ -39,7 +39,7 @@ static void spi_set_frequency(const struct device *dev, const struct spi_config
 
 	if (!dev_config->clk_divider_exists) {
 		/* The clk_divider is optional, that's why we check. */
-		LOG_WRN("No clk_divider found, can't change frequency");
+		LOG_DBG("No clk_divider found, can't change frequency");
 		return;
 	}
 
@@ -69,15 +69,10 @@ static int spi_config(const struct device *dev, const struct spi_config *config,
 		return -ENOTSUP;
 	}
 
-	if (config->operation & SPI_CS_ACTIVE_HIGH) {
-		LOG_ERR("CS active high not supported");
-		return -ENOTSUP;
-	}
+	/* SPI_CS_ACTIVE_HIGH is allowed — the xfer function inverts CS logic
+	 * when this flag is set (needed for SD card init sequence). */
 
-	if (config->operation & SPI_LOCK_ON) {
-		LOG_ERR("Lock On not supported");
-		return -ENOTSUP;
-	}
+	/* SPI_LOCK_ON: ignored — single-master, no contention possible. */
 
 	if (IS_ENABLED(CONFIG_SPI_EXTENDED_MODES) &&
 	    (config->operation & SPI_LINES_MASK) != SPI_LINES_SINGLE) {
@@ -150,8 +145,13 @@ static void spi_litex_xfer(const struct device *dev,
 	struct spi_context *ctx = &dev_data->ctx;
 	uint32_t txd, rxd;
 
-	/* Set CS */
-	litex_write16(BIT(config->slave), dev_config->cs_addr);
+	/* Set CS: normally assert (BIT), but when SPI_CS_ACTIVE_HIGH
+	 * is set the caller wants CS deasserted during the transfer. */
+	if (config->operation & SPI_CS_ACTIVE_HIGH) {
+		litex_write16(0, dev_config->cs_addr);
+	} else {
+		litex_write16(BIT(config->slave), dev_config->cs_addr);
+	}
 
 	do {
 		/* Send a frame */
@@ -179,8 +179,12 @@ static void spi_litex_xfer(const struct device *dev,
 
 	spi_context_complete(ctx, dev, 0);
 
-	/* Clear CS */
-	litex_write16(0, dev_config->cs_addr);
+	/* Restore CS to idle state */
+	if (config->operation & SPI_CS_ACTIVE_HIGH) {
+		litex_write16(BIT(config->slave), dev_config->cs_addr);
+	} else {
+		litex_write16(0, dev_config->cs_addr);
+	}
 }
 
 /* API Functions */
