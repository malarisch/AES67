#include <zephyr/dt-bindings/dma/stm32_dma.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>

/* Custom SPI1 pinctrl with pull-up on MISO for SD card */
&pinctrl {
	spi1_sd_miso_pa6: spi1_sd_miso_pa6 {
		pinmux = <STM32_PINMUX('A', 6, AF5)>;
		bias-pull-up;
	};
};

/* Ensure SYSCLK/HCLK are configured for a fast AHB3 (FMC) clock. */
&clk_hse {
	hse-bypass;
	clock-frequency = <8000000>;
	status = "okay";
};

&pll {
	div-m = <2>;
	mul-n = <240>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&pll2 {
	div-m = <4>;
	mul-n = <120>;
	div-p = <2>;
	div-q = <3>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <480000000>;
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre1 = <2>;
	d2ppre2 = <2>;
	d3ppre = <2>;
};

&dma1 {
	status = "okay";
};

&dma2 {
	status = "okay";
};

&dmamux1 {
	status = "okay";
};

/* Enable HSI for SPI1 clock (64MHz allows 250kHz min for SD init) */
&clk_hsi {
	status = "okay";
	hsi-div = <1>;  /* 64 MHz */
};

/* ---- SD Card on SPI1 (PA5=SCK, PA6=MISO, PB5=MOSI, PA4=CS) ---- */
&spi1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_sck_pa5 &spi1_sd_miso_pa6 &spi1_mosi_pb5>;
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
	/* Use HSI (64MHz) as clock source - allows 250kHz min for SD card init */
	clocks = <&rcc STM32_CLOCK(APB2, 12U)>,
	         <&rcc STM32_SRC_HSI_KER SPI123_SEL(0)>;

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <1000000>;
		power-delay-ms = <1000>;
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

/* ---- Si5351A clock generator on I2C1 (PB8=SCL, PB9=SDA) ---- */
&i2c1 {
	status = "okay";

	si5351a: si5351a@60 {
		compatible = "silabs,si5351a";
		reg = <0x60>;
		clock-frequency = <25000000>;   /* 25 MHz crystal */
		silabs,xtal-load-pf = <10>;     /* 10 pF load cap */
	};

	ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;
	};
};

/* ---- MI Card I2C bus (I2C2: PB10=SCL, PB11=SDA) ---- */
/* 8-channel ADC preamp board with LPC microcontroller (0x40) and DSP (0x14) */
&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb11>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;  /* 100 kHz - conservative for long wires */
};

/* ---- MI Card nRST GPIO (PA8 active-low) ---- */
/* Disabled for LO card testing
/ {
	mi_card_gpios {
		compatible = "gpio-leds";
		mi_nrst: mi_nrst {
			gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;
			label = "MI Card nRST";
		};
	};

	aliases {
		mi-nrst = &mi_nrst;
	};
};
*/

/* ---- LO Card nRST GPIO (PA8 active-low, same pinout as MI) ---- */
/ {
	lo_card_gpios {
		compatible = "gpio-leds";
		lo_nrst: lo_nrst {
			gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;
			label = "LO Card nRST";
		};
	};

	aliases {
		lo-nrst = &lo_nrst;
	};
};

/* ---- Display Controller nRST GPIO (PA9 active-low) ---- */
/ {
	display_ctrl_gpios {
		compatible = "gpio-leds";
		dc_nrst: dc_nrst {
			gpios = <&gpioa 9 GPIO_ACTIVE_LOW>;
			label = "Display Ctrl nRST";
		};
	};

	aliases {
		dc-nrst = &dc_nrst;
	};
};

/* Disable user_button to prevent conflict on PC13 */
&user_button {
	status = "disabled";
};

&mac {
	status = "disabled";
};

&fdcan1 {
	status = "disabled";
};

&lpuart1 {
    status = "disabled";
};

/* Enable FMC bank 0 with a 16-bit bus on unused pins for the Ethernet FMC bridge */
#include <zephyr/dt-bindings/memory-controller/stm32-fmc-nor-psram.h>

&fmc {
	status = "okay";
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(AHB3, 12)>;  // Bit 12 = FMCEN
	pinctrl-0 = <
		&fmc_a0_pf0 &fmc_a1_pf1 &fmc_a2_pf2 &fmc_a3_pf3
		&fmc_a4_pf4 &fmc_a5_pf5 &fmc_a6_pf12
		&fmc_d0_pd14 &fmc_d1_pd15 &fmc_d2_pd0 &fmc_d3_pd1
		&fmc_d4_pe7 &fmc_d5_pe8 &fmc_d6_pe9 &fmc_d7_pe10
		&fmc_noe_pd4 &fmc_nwe_pd5 &fmc_ne1_pd7
	>;

	sram {
		compatible = "st,stm32-fmc-nor-psram";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;

		eth_fmc: sram@1 {
			reg = <0x0>; /* Bank 1 (NE1) */
			st,control = <STM32_FMC_DATA_ADDRESS_MUX_DISABLE
						  STM32_FMC_MEMORY_TYPE_SRAM
						  STM32_FMC_NORSRAM_MEM_BUS_WIDTH_8
						  STM32_FMC_BURST_ACCESS_MODE_DISABLE
						  STM32_FMC_WAIT_SIGNAL_POLARITY_LOW
						  STM32_FMC_WAIT_TIMING_BEFORE_WS
						  STM32_FMC_WRITE_OPERATION_ENABLE
						  STM32_FMC_WAIT_SIGNAL_DISABLE
						  STM32_FMC_EXTENDED_MODE_DISABLE
						  STM32_FMC_ASYNCHRONOUS_WAIT_DISABLE
						  STM32_FMC_WRITE_BURST_DISABLE
						  STM32_FMC_CONTINUOUS_CLOCK_SYNC_ONLY
						  STM32_FMC_WRITE_FIFO_DISABLE
						  STM32_FMC_PAGE_SIZE_NONE>;
			/* ADDSET ADDHLD DATAST BUSTURN CLKDIV DATLAT mode
			 * FPGA clk_sys = 250 MHz (4 ns).  Read path uses 2-FF
			 * CDC synchronisers, so data appears on fmc_read_data_lat
			 * ~3 clk_sys cycles (12 ns) after NOE falling edge.
			 * DATAST=15 (62.5 ns) gives plenty of margin.
			 * BUSTURN=4 (16.7 ns) ensures NOE deasserts long enough
			 * for the FPGA to detect fmc_read_latched='0' and
			 * re-arm for the next read cycle.
			 * ADDSET=4 (16.7 ns) is sufficient for address setup. */
			st,timing = <4 1 15 4 3 9 STM32_FMC_ACCESS_MODE_A>;
		};
	};
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* Display Controller UART (UART4 on PC10/PC11) - 115200 baud */
/* Controls front panel LEDs, buttons, and 7-segment displays */
&uart4 {
	pinctrl-0 = <&uart4_tx_pc10 &uart4_rx_pc11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* 
 * Define an MPU region for the FMC bank 1 (0x60000000).
 * This is critical to prevent speculative access crashes on Cortex-M7
 * when the FPGA is not driving the bus or before initialization.
 * Attribute "IO" ensures Device memory semantics (no speculation, no cache).
 */
/ {
	fmc_memory: memory@60000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x60000000 0x10000>;
		zephyr,memory-region = "FMC_ETH_MEM";
		zephyr,memory-attr = <( DT_MEM_ARM(ATTR_MPU_IO) )>;
	};
};

/ {
	chosen {
		zephyr,console = &usart3;
		zephyr,shell-uart = &usart3;
		zephyr,display = &ssd1306;
	};

	aliases {
		display-ctrl-uart = &uart4;
	};

	fpga_ctrl {
		compatible = "gpio-keys";
		fpga_ready: fpga_ready {
			gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
			label = "FPGA Ready";
		};
		fpga_int: fpga_int {
			gpios = <&gpiob 2 GPIO_ACTIVE_HIGH>;
			label = "FPGA Interrupt";
		};
	};
};
