
rsource "drivers/Kconfig"

config AES67_PTP_SOFTWARE
	bool "Run PTP in software (Zephyr IEEE 1588 stack) instead of FPGA hardware PTP"
	default n
	depends on FPGA_HAL_LITEX || FPGA_HAL_SPI
	depends on PTP
	help
	  Use Zephyr's IEEE 1588 PTP stack (CONFIG_PTP) to discipline the FPGA
	  wallclock, instead of the FPGA's hardware PTP state machine + servo.
	  Works on the integrated softcore (FPGA_HAL_LITEX) and on an external
	  MCU over spibone (FPGA_HAL_SPI). Requires the gateware built with
	  `--ptp-in-software` / PTP_IN_SOFTWARE=true (exposes wallclock in/out,
	  set/phasejump/ppb, the TX-timestamp CSR and the RX-timestamp trailer).
	  The Ethernet driver (eth_litex / eth_spi) then advertises ETHERNET_PTP,
	  returns the aes67 PHC via get_ptp_clock, stamps RX frames from the FPGA
	  trailer and reports TX timestamps. The firmware's FPGA-BMC path
	  (ptp_bmc.c) is not started in this mode.

	  Do not `select` PTP here: it would form a Kconfig dependency loop with
	  the FPGA_HAL backend choice (PTP -> NET_SOCKETS -> ... -> SPI). Enable
	  this mode via the ptpsw.conf overlay, which turns on CONFIG_PTP and this
	  option together.

# Extends the symbol of the same name from Zephyr's ESP32 WiFi driver
# (drivers/wifi/esp32/Kconfig.esp32), where it is hidden behind `if
# WIFI_ESP32`. The ESP32-S3 linker script keys the placement of the whole
# Zephyr net stack's .noinit input sections (net_pkt slabs, net_buf data
# pools — the big RAM consumers) into PSRAM on this symbol, independent of
# WiFi. Re-declaring it here makes it settable on the wired-Ethernet
# (eth_spi over spibone) build without dragging the WiFi stack in.
config ESP32_WIFI_NET_ALLOC_SPIRAM
	bool "Place Zephyr network stack buffers in SPIRAM (PSRAM)"
	depends on ESP_SPIRAM
	help
	  Moves the network subsystem's .noinit data (packet slabs and
	  net_buf pools) into external PSRAM, freeing internal DRAM for
	  stacks and heap. Requires CONFIG_ESP_SPIRAM.

config APP_SPI_BRINGUP
	bool "Build the SPI bring-up stub instead of the full control plane"
	default n
	depends on FPGA_HAL_SPI
	help
	  When set, build the minimal main_spi_bringup.c that only programs
	  default registers and polls status. Useful for bare SPI bring-up
	  before the full networking stack is on the board. The full app
	  (HTTP / RTSP / mDNS / PTP BMC) is the default for every HAL
	  backend that has networking, including SPI.

menu "RAVENNA RTSP Server/Client"

config RTSP
	bool "Enable RTSP server and client for stream control"
	default y
	depends on NETWORKING && NET_TCP && NET_SOCKETS
	help
	  Enable RAVENNA-compliant RTSP (RFC 2326) server and client.
	  The server exposes TX streams for remote subscription via
	  DESCRIBE/SETUP/PLAY commands. The client can subscribe to
	  remote streams for RX configuration.

config RTSP_AUTO_START
	bool "Auto-start RTSP server at boot"
	default y
	depends on RTSP
	help
	  Automatically start the RTSP server when the network is ready.
	  If disabled, use the 'rtsp start' shell command to start manually.

config RTSP_PORT
	int "RTSP server port"
	default 554
	depends on RTSP
	help
	  TCP port for the RTSP server. Standard RTSP port is 554.

config RTSP_MAX_SESSIONS
	int "Maximum concurrent RTSP sessions"
	default 8
	depends on RTSP
	help
	  Maximum number of concurrent streaming sessions the server
	  can maintain.

config RTSP_MAX_CLIENTS
	int "Maximum RTSP client connections"
	default 4
	depends on RTSP
	help
	  Maximum number of outgoing client connections for
	  subscribing to remote streams.

endmenu

menu "RAVENNA mDNS/DNS-SD Discovery"

config MDNS_SD
	bool "Enable mDNS/DNS-SD service advertisement + discovery"
	default y
	depends on NETWORKING
	help
	  Advertise HTTP and RTSP services (plus per-session
	  _ravenna_session._sub._rtsp._tcp records) and browse for
	  remote RAVENNA sessions per Operating Principles §3.5.
	  Self-contained responder+browser on UDP 5353 — do NOT enable
	  Zephyr's CONFIG_MDNS_RESPONDER alongside (both bind :5353).

config MDNS_SD_VENDOR_ID
	string "Vendor identifier"
	default "AES67"
	depends on MDNS_SD
	help
	  Vendor name for the RAVENNA vendor node ID.

config MDNS_SD_PRODUCT_ID
	string "Product identifier"
	default "AudioNode"
	depends on MDNS_SD
	help
	  Product name for the RAVENNA vendor node ID.

config MDNS_SD_SERIAL
	string "Device serial number"
	default "0001"
	depends on MDNS_SD
	help
	  Serial number for the RAVENNA vendor node ID.
	  Must be unique per device.

endmenu

menu "SD Card Configuration Storage"

config SD_CONFIG
	bool "Enable SD card configuration storage"
	default y
	depends on FILE_SYSTEM && FAT_FILESYSTEM_ELM && DISK_ACCESS
	help
	  Store device configuration and stream settings on SD card as JSON.
	  The config file is loaded at boot and saved when changes are made.

endmenu

menu "Flash Configuration Storage"

config FLASH_CONFIG
	bool "Enable flash configuration storage"
	default y
	depends on SPI_FLASH_LITESPI || FLASH_MAP
	help
	  Store device configuration in flash using a crash-safe A/B slot
	  scheme with CRC-32 verification. Provides a fallback when no SD
	  card is present. The storage backend follows the platform: the
	  FPGA board's SPI NOR flash via the LiteSPI spi_flash driver on
	  the integrated softcore, or the MCU's own program flash (fixed
	  "storage" partition via the Zephyr flash map) on external-MCU
	  builds such as the ESP32-S3.

config FLASH_CONFIG_BACKEND_LITESPI
	def_bool SPI_FLASH_LITESPI
	depends on FLASH_CONFIG

config FLASH_CONFIG_BACKEND_FLASH_AREA
	def_bool !SPI_FLASH_LITESPI && FLASH_MAP
	depends on FLASH_CONFIG

config FLASH_CONFIG_OFFSET
	hex "Flash offset for config storage (0-based)"
	default 0x7F0000
	depends on FLASH_CONFIG_BACKEND_LITESPI
	help
	  Byte offset within the SPI flash where config storage begins.
	  Two 8 KB slots are placed here (16 KB total).
	  Default 0x7F0000 = 8 MB - 64 KB, well above firmware area.
	  (The flash-map backend ignores this and uses the "storage"
	  partition from the devicetree instead.)

endmenu

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"
