config FPGA_SPI
	bool "FPGA SPI register driver"
	depends on SPI
	help
	  Enable the SPI driver that talks to the on-FPGA spictrl block
	  (see FPGA/spictrl.vhd). Requires a chosen node
	  `zephyr,fpga-spi` pointing at the SPI slave representing the
	  FPGA on the bus.

if FPGA_SPI

module = FPGA_SPI
module-str = fpga_spi
source "subsys/logging/Kconfig.template.log_config"

config FPGA_SPI_INIT_PRIORITY
	int "FPGA SPI driver init priority"
	default 60
	help
	  Must run after the SPI controller (typically 50) and before
	  the FPGA HAL backend that uses it.

endif # FPGA_SPI
