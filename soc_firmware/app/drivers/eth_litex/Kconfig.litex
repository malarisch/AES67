menuconfig ETH_LITEX
	bool "LiteX SoC Ethernet interface"
	select NET_L2_ETHERNET
	help
	  Ethernet driver for the LiteX-generated AES67 SoC.
	  Uses CSR registers for control/status and a Wishbone-mapped
	  dual-port packet buffer (1500 bytes RX + 1500 bytes TX).

if ETH_LITEX

config ETH_LITEX_MAC_ADDR
	string "MAC address (XX:XX:XX:XX:XX:XX)"
	default "02:1C:23:17:AC:AB"
	help
	  Locally-administered MAC address used by the LiteX Ethernet
	  driver. Override per board in the board .conf file when
	  running multiple units on the same network — duplicate MACs
	  cause ARP/IGMP havoc. Bit 1 of the first byte should be set
	  to mark the address as locally administered.

config ETH_LITEX_POLL_INTERVAL_MS
	int "RX poll interval (ms)"
	default 100
	help
	  Fallback polling interval when no IRQ fires. The driver
	  uses k_sem_take with this timeout, so actual RX latency
	  is typically much lower when the IRQ is working.

config ETH_LITEX_RX_STACK_SIZE
	int "RX/TX thread stack size"
	default 2048
	help
	  Stack size for RX and TX worker threads.

config ETH_LITEX_TX_QUEUE_DEPTH
	int "TX packet queue depth"
	default 16
	help
	  Number of packets that can be queued for transmission.
	  Increase this if the device handles bursty TCP traffic
	  (e.g. a web server serving multiple browser connections).

endif # ETH_LITEX
