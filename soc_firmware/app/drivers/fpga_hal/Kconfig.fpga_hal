menuconfig FPGA_HAL
	bool "FPGA Hardware Abstraction Layer"
	help
	  Common abstraction layer for FPGA register access.
	  Exactly one backend must be selected.

if FPGA_HAL

choice FPGA_HAL_BACKEND
	prompt "FPGA HAL backend"
	default FPGA_HAL_FMC if ETH_FMC_BASIC
	default FPGA_HAL_LITEX if ETH_LITEX
	default FPGA_HAL_SPI if SPIBONE

config FPGA_HAL_FMC
	bool "FMC backend (STM32H7)"
	depends on ETH_FMC_BASIC
	help
	  Use the FMC Ethernet bridge driver for FPGA register access.

config FPGA_HAL_LITEX
	bool "LiteX CSR backend"
	depends on ETH_LITEX
	help
	  Use LiteX CSR registers for FPGA register access.

config FPGA_HAL_SPI
	bool "SPI backend (external MCU, spibone)"
	depends on SPIBONE
	help
	  Reach the aes67_bridge CSR map over the LiteX spibone
	  SPI-to-Wishbone bridge. Intended for boards where Zephyr runs
	  on an external MCU (e.g. ESP32-S3) and drives CPU-less FPGA
	  gateware over SPI.

endchoice

config FPGA_HAL_SHELL
	bool "FPGA HAL shell commands"
	depends on SHELL
	default y
	help
	  Register an `fpga` shell command tree that exposes the HAL read
	  and write APIs (status, mac, ip, ptp, gm, ctrl set/clear, adda,
	  meter, tx, rx). Works with every HAL backend.

config AES67_SPIBONE_PROBE
	bool "Probe the spibone bus at boot (scratch-register sanity check)"
	depends on FPGA_HAL_SPI
	default y
	help
	  After the drivers come up, read the LiteX ctrl scratch register
	  (known reset value 0x12345678, when present) and round-trip a set
	  of patterns through the AES67 scratch register, logging whether
	  the spibone Wishbone bus actually responds. Turns a silent "FPGA
	  doesn't respond" into a definite bus-up/bus-down verdict before
	  the reset-staging in main() (which reads the reset CSR over the
	  same bus) runs. Cheap; leave on for bring-up.

endif # FPGA_HAL
