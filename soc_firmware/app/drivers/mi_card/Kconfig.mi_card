# SPDX-License-Identifier: Apache-2.0

config MI_CARD
	bool "MI Card 8-channel preamp board driver"
	depends on I2C
	help
	  Enable driver for the MI 8-channel ADC preamp board.
	  This board has an LPC microcontroller (at I2C address 0x40)
	  controlling preamp gain and phantom power, plus a DSP chip
	  (at I2C address 0x14).

if MI_CARD

config MI_CARD_LOG_LEVEL
	int "MI card driver log level"
	default 3
	range 0 4
	help
	  Log level for MI card driver.
	  0 = OFF, 1 = ERR, 2 = WRN, 3 = INF, 4 = DBG

config MI_CARD_INIT_PRIORITY
	int "MI card driver initialization priority"
	default 80
	help
	  Device driver initialization priority for MI card.
	  Must be initialized after I2C bus.

endif # MI_CARD
